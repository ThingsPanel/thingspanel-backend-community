# 北向服务（数据转发）单机编排的环境变量。
#
# 复制成 northbound.env 再改。northbound.env 已被 .gitignore 忽略，
# 不要把真实令牌提交进仓库。
#
# 每个变量对应 docs/northbound/DEPLOYMENT.md 第 2 节的哪一项，都写在注释里。

# ---------------------------------------------------------------------------
# 网络：与社区既有部署共用一张外部网络。
# 先确认社区 compose 建的网络名（docker network ls），再填这里。
# ---------------------------------------------------------------------------
TP_NETWORK=tp-community

# ---------------------------------------------------------------------------
# 数据库与缓存：北向服务不创建它们，只是连过去。
# 容器之间用服务名，不要写 127.0.0.1（那是容器自己）。
# ---------------------------------------------------------------------------
COMMUNITY_DSN=postgres://user:password@postgres:5432/thingspanel?sslmode=disable
NORTHBOUND_DSN=postgres://user:password@postgres:5432/northbound?sslmode=disable

# ---------------------------------------------------------------------------
# 秘密。三个令牌必须两两对齐，错了会以 401 的形式表现成「交接失败」。
# ---------------------------------------------------------------------------

# Encore 核心校验社区运行侧用的令牌。必须与社区后端
# northbound.service_token 完全一致。（DEPLOYMENT §2.1 NB_SERVICE_TOKEN）
NB_SERVICE_TOKEN=change-me-service-token

# 租户凭证的加密密钥材料。为空则保存凭证失败；改了它则所有已存凭证都解不开。
# 生成：openssl rand -hex 32
NB_SECRET_KEY=change-me-32-bytes-of-key-material

# 平台调用插件用的令牌。必须与两个插件的 --token 完全一致。
NB_PLUGIN_TOKEN=change-me-plugin-token

# ---------------------------------------------------------------------------
# 端口映射（宿主机:容器）。宿主机端口只绑 127.0.0.1，不对外暴露。
# ---------------------------------------------------------------------------
NB_CORE_HOST_PORT=4020
NB_CORE_CONTAINER_PORT=4000
NB_HTTP_PLUGIN_HOST_PORT=18081
NB_MQTT_PLUGIN_HOST_PORT=18082

# ---------------------------------------------------------------------------
# 容量与调度。默认值来自 docs/northbound/CONTRACT-v1.md §8，一般不用改。
# ---------------------------------------------------------------------------
NB_WORKERS=8
NB_MAX_BACKLOG_EVENTS=20000
NB_MAX_BATCH_EVENTS=200
NB_MAX_EVENT_BYTES=262144
NB_LEASE=30s
NB_MAX_ATTEMPTS=12
NB_EVENT_RETENTION=168h
NB_DELIVERY_RETENTION=720h

# ---------------------------------------------------------------------------
# 镜像
# ---------------------------------------------------------------------------
# Encore 核心镜像由 `encore build docker` 产出，不是本目录的 Dockerfile 构建的：
#   cd encore-api && encore build docker <这里填的 tag> --arch amd64
NB_CORE_IMAGE=tp/northbound-core:dev

# 两个插件镜像由本目录的 Dockerfile.plugin 构建（compose build 会自动处理）
NB_HTTP_PLUGIN_IMAGE=tp/northbound-sink-http:dev
NB_MQTT_PLUGIN_IMAGE=tp/northbound-sink-mqtt:dev
