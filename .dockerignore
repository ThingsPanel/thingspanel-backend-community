# Only source and declared runtime assets enter the default backend build.
**
!go.mod
!go.sum
!*.go
!LICENSE
!initialize/
!initialize/**
!internal/
!internal/**
!pkg/
!pkg/**
!router/
!router/**
!mqtt/
!mqtt/**
!third_party/
!third_party/**
!sql/
!sql/**
!static/
!static/**
!configs/
!configs/conf.yml
!configs/casbin.conf
!configs/messages.yaml
!configs/messages_str.yaml
!configs/rsa_key/
!configs/rsa_key/private_key.pem
!configs/rsa_key/public.pem
# Keep accidental local artifacts out even under source directories.
**/__pycache__
**/*.pyc
**/*.log
**/*.tmp
**/*.bak
**/*.private.json
**/.env
**/.env.*
**/node_modules
**/.cache

# Generated Swagger registration is linked by router.
!docs/
!docs/*.go
!files/
!files/iphone-1.png
!files/iphone-2.png
!files/logo.png
