# Only source and declared runtime assets enter the default backend build.
**
!go.mod
!go.sum
!*.go
!LICENSE
!initialize/
!initialize/**
!internal/
!internal/**
!pkg/
!pkg/**
!router/
!router/**
!mqtt/
!mqtt/**
!third_party/
!third_party/**
!sql/
!sql/**
!encore-api/
!encore-api/automation/
!encore-api/automation/migrations/
!encore-api/devicemetadata/
!encore-api/devicemetadata/migrations/
!encore-api/l3-core/
!encore-api/l3-core/notification/
!encore-api/l3-core/notification/migrations/
!encore-api/automation/migrations/*.up.sql
!encore-api/devicemetadata/migrations/*.up.sql
!encore-api/l3-core/notification/migrations/*.up.sql
!static/
!static/**
!configs/
!configs/conf.yml
!configs/casbin.conf
!configs/messages.yaml
!configs/messages_str.yaml
!configs/rsa_key/
!configs/rsa_key/private_key.pem
!configs/rsa_key/public.pem
# Keep accidental local artifacts out even under source directories.
**/__pycache__
**/*.pyc
**/*.log
**/*.tmp
**/*.bak
**/*.private.json
**/.env
**/.env.*
**/node_modules
**/.cache

# Generated Swagger registration is linked by router.
!docs/
!docs/*.go
!files/
!files/iphone-1.png
!files/iphone-2.png
!files/logo.png

!notification-adapters/
!notification-adapters/go.mod
!notification-adapters/sdk/
!notification-adapters/sdk/*.go
!notification-adapters/smtp/
!notification-adapters/smtp/*.go
!notification-adapters/unipush/
!notification-adapters/unipush/*.go
!notification-adapters/cmd/
!notification-adapters/cmd/*.go
!notification-adapters/cmd/smtp/
!notification-adapters/cmd/smtp/*.go
!notification-adapters/cmd/unipush/
!notification-adapters/cmd/unipush/*.go
