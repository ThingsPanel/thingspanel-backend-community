+
+// SQL owners carry exact authenticated provenance into DB write guards. This
+// does not authorize a background caller; a worker must instead load its own
+// immutable outbox binding proof in the same receipt transaction.
+func currentRuntimeSourceRaw() string {
+	data := authn.CurrentData()
+	if data == nil {
+		return ""
+	}
+	return data.TenantID
+}
+func validateSQLSourceRaw(ctx context.Context, reader runtimetenant.Queryer, tenantID, raw string) error {
+	var expected sql.NullString
+	e := reader.QueryRowContext(ctx, `SELECT source_tenant_id FROM runtime_tenant_source_guards WHERE tenant_id=$1 AND proven=true`, tenantID).Scan(&expected)
+	if errors.Is(e, sql.ErrNoRows) || errors.Is(e, sqldb.ErrNoRows) {
+		return nil
+	}
+	if e != nil || !expected.Valid || expected.String != raw {
+		return runtimeSourceUnavailable()
+	}
+	return nil
+}
