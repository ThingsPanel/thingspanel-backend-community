+-- A permanent unique owner guard coordinates first native writes with source
+-- provisioning. An unproven historical tenant can never become proven merely
+-- because its last business row was deleted.
+CREATE TABLE runtime_tenant_source_guards (
+ tenant_id UUID PRIMARY KEY,
+ source_tenant_id TEXT,
+ proven BOOLEAN NOT NULL,
+ CHECK((proven AND source_tenant_id IS NOT NULL AND length(source_tenant_id)>0) OR (NOT proven AND source_tenant_id IS NULL)),
+ UNIQUE(tenant_id,source_tenant_id,proven)
+);
+CREATE FUNCTION guard_runtime_tenant_source_reservation() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+ IF TG_OP='DELETE' OR NEW IS DISTINCT FROM OLD THEN RAISE EXCEPTION 'runtime tenant source guard is immutable'; END IF;
+ RETURN NEW;
+END;$$;
+CREATE TRIGGER runtime_source_reservation_immutable BEFORE UPDATE OR DELETE ON runtime_tenant_source_guards FOR EACH ROW EXECUTE FUNCTION guard_runtime_tenant_source_reservation();
+
 -- No automatic backfill: historical UUID normalization cannot prove source
 -- ownership. Only the local dual-session operator owner may provision a row.
 CREATE TABLE runtime_tenant_sources (
@@ -10,6 +27,8 @@ CREATE TABLE runtime_tenant_sources (
  service_instance_id TEXT NOT NULL,
  community_origin TEXT NOT NULL,
  generation BIGINT NOT NULL DEFAULT 1 CHECK(generation=1),
+ source_guard_proven BOOLEAN NOT NULL DEFAULT true CHECK(source_guard_proven),
+ FOREIGN KEY(tenant_id,source_tenant_id,source_guard_proven) REFERENCES runtime_tenant_source_guards(tenant_id,source_tenant_id,proven),
  state TEXT NOT NULL DEFAULT 'active' CHECK(state IN ('active','revoked')),
  reviewed_manifest_sha256 TEXT NOT NULL CHECK(reviewed_manifest_sha256 ~ '^[0-9a-f]{64}$'),
  platform_actor_id TEXT NOT NULL,
@@ -55,3 +74,30 @@ BEGIN
  RETURN NEW;
 END;$$;
 CREATE TRIGGER runtime_outbox_source_immutable BEFORE UPDATE ON device_runtime_outbox FOR EACH ROW EXECUTE FUNCTION guard_runtime_outbox_source();
+
+-- All native business writers, including a request whose canonical tenant was
+-- cached before registration, must honor the permanent raw source owner. An
+-- An absent guard is resolved by a unique UPSERT, not an absent-row precheck;
+-- REPEATABLE READ callers serialize/fail if the guard was created meanwhile.
+-- Existing guards are immutable; their steady-state reads need no write lock.
+CREATE FUNCTION enforce_runtime_tenant_source_writer() RETURNS trigger LANGUAGE plpgsql SET search_path FROM CURRENT AS $$
+DECLARE target uuid; owner_raw text; owner_proven boolean;
+BEGIN
+ IF TG_OP='DELETE' THEN target:=OLD.tenant_id; ELSE target:=NEW.tenant_id; END IF;
+ SELECT source_tenant_id,proven INTO owner_raw,owner_proven FROM runtime_tenant_source_guards WHERE tenant_id=target;
+ IF NOT FOUND THEN
+  INSERT INTO runtime_tenant_source_guards(tenant_id,source_tenant_id,proven) VALUES(target,NULL,false)
+  ON CONFLICT(tenant_id) DO UPDATE SET tenant_id=EXCLUDED.tenant_id
+  RETURNING source_tenant_id,proven INTO owner_raw,owner_proven;
+ END IF;
+ IF owner_proven AND current_setting('app.current_source_tenant_id',true) IS DISTINCT FROM owner_raw THEN
+  RAISE EXCEPTION 'registered native tenant requires its verified raw source owner';
+ END IF;
+ IF TG_OP='DELETE' THEN RETURN OLD; END IF; RETURN NEW;
+END;$$;
+DO $$ DECLARE item record; BEGIN
+ FOR item IN SELECT c.relname FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace JOIN pg_attribute a ON a.attrelid=c.oid
+ WHERE n.nspname=current_schema() AND c.relkind IN ('r','p') AND a.attname='tenant_id' AND a.attnum>0 AND NOT a.attisdropped
+ AND c.relname NOT IN ('runtime_tenant_sources','runtime_tenant_source_guards')
+ LOOP EXECUTE format('CREATE TRIGGER runtime_source_writer_guard BEFORE INSERT OR UPDATE OR DELETE ON %I FOR EACH ROW EXECUTE FUNCTION enforce_runtime_tenant_source_writer()',item.relname); END LOOP;
+END;$$;
